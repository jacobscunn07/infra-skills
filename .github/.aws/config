# AWS config for GitHub Actions CI/CD.
#
# All profiles use credential_source = Environment — the aws-actions/configure-aws-credentials
# action sets AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and AWS_SESSION_TOKEN in the runner
# environment after assuming the OIDC bootstrap role (AWS_ROLE_ARN repo variable).
#
# For local development, add matching profiles to ~/.aws/config using source_profile instead.
# See docs/reference/local-dev-setup.md for the local profile template.
#
# Profile naming: terraform-<shared-role> or tf-<project>-<workspace>
# Onboarding a new project: add one [profile tf-<name>-<workspace>] block per workspace.

# ── Shared roles ──────────────────────────────────────────────────────────────

[profile terraform-backend]
role_arn           = REPLACE_WITH_BACKEND_ROLE_ARN
credential_source  = Environment

[profile terraform-ssm]
role_arn           = REPLACE_WITH_SSM_ROLE_ARN
credential_source  = Environment

# ── tf-network-spoke ──────────────────────────────────────────────────────────

[profile tf-network-spoke-dev]
role_arn           = REPLACE_WITH_TF_NETWORK_SPOKE_DEV_ROLE_ARN
credential_source  = Environment

[profile tf-network-spoke-staging]
role_arn           = REPLACE_WITH_TF_NETWORK_SPOKE_STAGING_ROLE_ARN
credential_source  = Environment

[profile tf-network-spoke-prod]
role_arn           = REPLACE_WITH_TF_NETWORK_SPOKE_PROD_ROLE_ARN
credential_source  = Environment

# ── tf-ecs ────────────────────────────────────────────────────────────────────

[profile tf-ecs-dev]
role_arn           = REPLACE_WITH_TF_ECS_DEV_ROLE_ARN
credential_source  = Environment

[profile tf-ecs-staging]
role_arn           = REPLACE_WITH_TF_ECS_STAGING_ROLE_ARN
credential_source  = Environment

[profile tf-ecs-prod]
role_arn           = REPLACE_WITH_TF_ECS_PROD_ROLE_ARN
credential_source  = Environment

# ── tf-data ───────────────────────────────────────────────────────────────────

[profile tf-data-dev]
role_arn           = REPLACE_WITH_TF_DATA_DEV_ROLE_ARN
credential_source  = Environment

[profile tf-data-staging]
role_arn           = REPLACE_WITH_TF_DATA_STAGING_ROLE_ARN
credential_source  = Environment

[profile tf-data-prod]
role_arn           = REPLACE_WITH_TF_DATA_PROD_ROLE_ARN
credential_source  = Environment
